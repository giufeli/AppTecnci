@inherits LayoutComponentBase
@using System.Net.Http.Json
@inject ILocalStorageService LocalStorage
@inject HttpClient Http

<RadzenComponents />

<RadzenLayout Style="grid-template-columns: auto 1fr; grid-template-rows: auto 1fr;">
    <RadzenHeader>
        <div class="d-flex justify-content-between align-items-center w-100 px-3">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
                <RadzenLabel Text="App Tecnici - Gestione Impianti" Style="font-weight: bold; margin-left: 10px; color: white;" />
            </RadzenStack>

            <div class="d-flex align-items-center gap-3">
                <RadzenButton Icon="sync"
                              Text="Sincronizza"
                              ButtonStyle="@(elementiDaSincronizzare > 0 ? ButtonStyle.Warning : ButtonStyle.Success)"
                              Size="ButtonSize.Small"
                              IsBusy="@inSincronizzazione"
                              Disabled="@(elementiDaSincronizzare == 0 || inSincronizzazione)"
                              Click="@SincronizzaDatiOffline"
                              ToolTip="@(elementiDaSincronizzare > 0 ? $"Ci sono {elementiDaSincronizzare} elementi da sincronizzare" : "Tutti i dati sono sincronizzati")" />

                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" style="color: white; text-decoration: none;">Informazioni</a>
            </div>
        </div>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <NavMenu />
    </RadzenSidebar>

    <RadzenBody>
        <div class="p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    private bool sidebarExpanded = true;
    private int elementiDaSincronizzare = 0;
    private bool inSincronizzazione = false;

    private const string CODA_IMPIANTI_KEY = "coda_impianti_offline";
    private const string CODA_INTERVENTI_KEY = "coda_interventi_offline";
    private const string CODA_ELIMINAZIONI_IMPIANTI_KEY = "coda_eliminazioni_impianti_offline";
    private const string CODA_ELIMINAZIONI_INTERVENTI_KEY = "coda_eliminazioni_interventi_offline";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ControllaCodaOffline();
    }

    private async Task ControllaCodaOffline()
    {
        var codaImpianti = await LocalStorage.GetItemAsync<List<Impianto>>(CODA_IMPIANTI_KEY) ?? new List<Impianto>();
        var codaInterventi = await LocalStorage.GetItemAsync<List<Intervento>>(CODA_INTERVENTI_KEY) ?? new List<Intervento>();
        var delImpianti = await LocalStorage.GetItemAsync<List<int>>(CODA_ELIMINAZIONI_IMPIANTI_KEY) ?? new List<int>();
        var delInterventi = await LocalStorage.GetItemAsync<List<int>>(CODA_ELIMINAZIONI_INTERVENTI_KEY) ?? new List<int>();

        int totaleNuovo = codaImpianti.Count + codaInterventi.Count + delImpianti.Count + delInterventi.Count;

        if (elementiDaSincronizzare != totaleNuovo)
        {
            elementiDaSincronizzare = totaleNuovo;
            StateHasChanged();
        }
    }

    private async Task SincronizzaDatiOffline()
    {
        inSincronizzazione = true;
        StateHasChanged();

        try
        {
            // 1. SINCRONIZZA ELIMINAZIONI IMPIANTI
            var delImpianti = await LocalStorage.GetItemAsync<List<int>>(CODA_ELIMINAZIONI_IMPIANTI_KEY) ?? new List<int>();
            var delImpiantiRimasti = new List<int>();
            foreach (var id in delImpianti)
            {
                var res = await Http.DeleteAsync($"api/impianti/{id}");
                if (!res.IsSuccessStatusCode && res.StatusCode != System.Net.HttpStatusCode.NotFound)
                {
                    delImpiantiRimasti.Add(id);
                }
            }
            await LocalStorage.SetItemAsync(CODA_ELIMINAZIONI_IMPIANTI_KEY, delImpiantiRimasti);

            // 2. SINCRONIZZA ELIMINAZIONI INTERVENTI
            var delInterventi = await LocalStorage.GetItemAsync<List<int>>(CODA_ELIMINAZIONI_INTERVENTI_KEY) ?? new List<int>();
            var delInterventiRimasti = new List<int>();
            foreach (var id in delInterventi)
            {
                var res = await Http.DeleteAsync($"api/interventi/{id}");
                if (!res.IsSuccessStatusCode && res.StatusCode != System.Net.HttpStatusCode.NotFound)
                {
                    delInterventiRimasti.Add(id);
                }
            }
            await LocalStorage.SetItemAsync(CODA_ELIMINAZIONI_INTERVENTI_KEY, delInterventiRimasti);

            // Recupera le liste locali a schermo per aggiornare gli ID temporanei
            var listaImpiantiLocale = await LocalStorage.GetItemAsync<List<Impianto>>("lista_impianti") ?? new List<Impianto>();
            var listaInterventiLocale = await LocalStorage.GetItemAsync<List<Intervento>>("lista_interventi") ?? new List<Intervento>();

            // 3. SINCRONIZZA CREAZIONI E MODIFICHE IMPIANTI
            var codaImpianti = await LocalStorage.GetItemAsync<List<Impianto>>(CODA_IMPIANTI_KEY) ?? new List<Impianto>();
            var codaInterventi = await LocalStorage.GetItemAsync<List<Intervento>>(CODA_INTERVENTI_KEY) ?? new List<Intervento>();
            var impiantiRimasti = new List<Impianto>();

            foreach (var imp in codaImpianti)
            {
                if (imp.IsNuovoOffline || imp.Id <= 0)
                {
                    int tempId = imp.Id; // ID temporaneo negativo
                    imp.Id = 0;

                    var res = await Http.PostAsJsonAsync("api/impianti", imp);
                    if (res.IsSuccessStatusCode)
                    {
                        var creato = await res.Content.ReadFromJsonAsync<Impianto>();
                        if (creato != null)
                        {
                            var idxLoc = listaImpiantiLocale.FindIndex(i => i.Id == tempId);
                            if (idxLoc != -1)
                            {
                                listaImpiantiLocale[idxLoc] = creato;
                                listaImpiantiLocale[idxLoc].IsNuovoOffline = false;
                            }

                            // Riconnetti gli interventi offline salvati con l'ID temporaneo
                            foreach (var inteOff in codaInterventi.Where(i => i.ImpiantoId == tempId))
                            {
                                inteOff.ImpiantoId = creato.Id;
                            }
                            foreach (var inteLoc in listaInterventiLocale.Where(i => i.ImpiantoId == tempId))
                            {
                                inteLoc.ImpiantoId = creato.Id;
                            }
                        }
                    }
                    else
                    {
                        imp.Id = tempId;
                        impiantiRimasti.Add(imp);
                    }
                }
                else
                {
                    var res = await Http.PutAsJsonAsync($"api/impianti/{imp.Id}", imp);
                    if (!res.IsSuccessStatusCode && res.StatusCode != System.Net.HttpStatusCode.NotFound)
                    {
                        impiantiRimasti.Add(imp);
                    }
                }
            }

            await LocalStorage.SetItemAsync(CODA_IMPIANTI_KEY, impiantiRimasti);
            await LocalStorage.SetItemAsync("lista_impianti", listaImpiantiLocale);

            // 4. SINCRONIZZA CREAZIONI E MODIFICHE INTERVENTI
            var interventiRimasti = new List<Intervento>();

            foreach (var inte in codaInterventi)
            {
                if (inte.IsNuovoOffline || inte.Id <= 0)
                {
                    int tempId = inte.Id;
                    inte.Id = 0;

                    var res = await Http.PostAsJsonAsync("api/interventi", inte);
                    if (res.IsSuccessStatusCode)
                    {
                        var creato = await res.Content.ReadFromJsonAsync<Intervento>();
                        if (creato != null)
                        {
                            var idxLoc = listaInterventiLocale.FindIndex(i => i.Id == tempId);
                            if (idxLoc != -1)
                            {
                                listaInterventiLocale[idxLoc] = creato;
                                listaInterventiLocale[idxLoc].IsNuovoOffline = false;
                            }
                        }
                    }
                    else
                    {
                        inte.Id = tempId;
                        interventiRimasti.Add(inte);
                    }
                }
                else
                {
                    var res = await Http.PutAsJsonAsync($"api/interventi/{inte.Id}", inte);
                    if (!res.IsSuccessStatusCode && res.StatusCode != System.Net.HttpStatusCode.NotFound)
                    {
                        interventiRimasti.Add(inte);
                    }
                }
            }

            await LocalStorage.SetItemAsync(CODA_INTERVENTI_KEY, interventiRimasti);
            await LocalStorage.SetItemAsync("lista_interventi", listaInterventiLocale);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore Sincronizzazione: {ex.Message}");
        }
        finally
        {
            inSincronizzazione = false;
            await ControllaCodaOffline();
        }
    }
}