@page "/interventi/nuovo"
@using System.Net.Http.Json
@inject ILocalStorageService LocalStorage
@inject NavigationManager NavigationManager
@inject HttpClient Http

<PageTitle>Nuovo Intervento</PageTitle>

<RadzenCard Style="max-width: 600px; margin: 2rem auto;">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" Class="mb-4">
        Inserisci Nuovo Intervento
    </RadzenText>

    <EditForm Model="@nuovoIntervento" OnValidSubmit="@SalvaIntervento">
        <DataAnnotationsValidator />
        <div class="text-danger mb-3">
            <ValidationSummary />
        </div>

        <div class="mb-3">
            <RadzenLabel Text="Impianto" Style="width: 100%; display: block;" />
            <RadzenDropDown @bind-Value="@nuovoIntervento.ImpiantoId"
                            Data="@impianti"
                            TextProperty="Nome"
                            ValueProperty="Id"
                            Placeholder="Seleziona un impianto..."
                            Style="width: 100%;" />
        </div>

        <div class="mb-3">
            <RadzenLabel Text="Titolo" Style="width: 100%; display: block;" />
            <RadzenTextBox @bind-Value="@nuovoIntervento.Titolo" Style="width: 100%;" />
        </div>

        <div class="mb-3">
            <RadzenLabel Text="Descrizione" Style="width: 100%; display: block;" />
            <RadzenTextArea @bind-Value="@nuovoIntervento.Descrizione" Style="width: 100%;" Rows="3" />
        </div>

        <div class="mb-3">
            <RadzenLabel Text="Data Intervento" Style="width: 100%; display: block;" />
            <RadzenDatePicker @bind-Value="@nuovoIntervento.DataIntervento" DateFormat="dd/MM/yyyy HH:mm" ShowTime="true" Style="width: 100%;" />
        </div>

        <div class="mb-3">
            <RadzenLabel Text="Stato" Style="width: 100%; display: block;" />
            <RadzenDropDown @bind-Value="@nuovoIntervento.Stato" Data="@stati" Style="width: 100%;" />
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Annulla" Click="@Annulla" />
            <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Salva" />
        </div>
    </EditForm>
</RadzenCard>

@code {
    // Nuovo oggetto intervento inizializzato con la data e l'ora attuali
    private Intervento nuovoIntervento = new Intervento { DataIntervento = DateTime.Now };
    
    // Lista degli impianti per popolare la tendina di selezione nel form
    private List<Impianto>? impianti;
    
    // Opzioni disponibili per lo stato del nuovo intervento
    private List<string> stati = new List<string> { "In attesa", "In corso", "Completato", "Annullato" };

    // Chiavi per la gestione della cache locale e della coda offline
    private const string STORAGE_KEY_IMPIANTI = "lista_impianti";
    private const string STORAGE_KEY_INTERVENTI = "lista_interventi";
    private const string CODA_OFFLINE_KEY = "coda_interventi_offline";

    // Al primo rendering carica prima gli impianti in cache per la selezione rapida, poi aggiorna da API
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Tenta il recupero immediato della lista impianti dalla cache locale
            var impiantiCached = await LocalStorage.GetItemAsync<List<Impianto>>(STORAGE_KEY_IMPIANTI);
            if (impiantiCached != null)
            {
                impianti = impiantiCached;
                StateHasChanged();
            }

            // Scarica la lista impianti aggiornata dal server se la connessione è disponibile
            try
            {
                var nuoviImpianti = await Http.GetFromJsonAsync<List<Impianto>>("api/impianti");
                if (nuoviImpianti != null)
                {
                    impianti = nuoviImpianti;
                    await LocalStorage.SetItemAsync(STORAGE_KEY_IMPIANTI, impianti);
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Errore caricamento impianti da API: {ex.Message}");
            }
        }
    }

    // Invia il nuovo intervento al server o lo salva in locale se si è offline
    private async Task SalvaIntervento()
    {
        try
        {
            // Tenta l'inserimento del record sul DB remoto tramite HTTP POST
            var response = await Http.PostAsJsonAsync("api/interventi", nuovoIntervento);
            if (response.IsSuccessStatusCode)
            {
                Intervento? creato = null;
                try
                {
                    creato = await response.Content.ReadFromJsonAsync<Intervento>();
                }
                catch { }

                // Usa l'intervento restituito dal server con l'ID reale assegnato da Azure SQL
                var interventoDefinitivo = creato ?? nuovoIntervento;
                interventoDefinitivo.IsNuovoOffline = false;
                await AggiornaLocalStorageEChiudi(interventoDefinitivo);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException || ex is TaskCanceledException)
        {
            // Gestione del salvataggio locale quando l'API non è raggiungibile
            var interventiSalvati = await LocalStorage.GetItemAsync<List<Intervento>>(STORAGE_KEY_INTERVENTI) ?? new List<Intervento>();

            // Assegna un ID temporaneo negativo progressivo (es. -1, -2)
            int minId = interventiSalvati.Where(i => i.Id < 0).Select(i => i.Id).DefaultIfEmpty(0).Min();
            int tempId = minId - 1;

            // Imposta i flag per contrassegnare l'intervento come creato offline
            nuovoIntervento.Id = tempId;
            nuovoIntervento.IsNuovoOffline = true;
            nuovoIntervento.Sincronizzato = false;

            // Inserisce l'intervento nella coda locale degli elementi in attesa di invio
            var coda = await LocalStorage.GetItemAsync<List<Intervento>>(CODA_OFFLINE_KEY) ?? new List<Intervento>();
            coda.Add(nuovoIntervento);
            await LocalStorage.SetItemAsync(CODA_OFFLINE_KEY, coda);

            await AggiornaLocalStorageEChiudi(nuovoIntervento);
        }
    }

    // Aggiunge l'intervento alla lista salvata in LocalStorage e reindirizza alla pagina principale degli interventi
    private async Task AggiornaLocalStorageEChiudi(Intervento interventoDaAggiungere)
    {
        var interventiSalvati = await LocalStorage.GetItemAsync<List<Intervento>>(STORAGE_KEY_INTERVENTI) ?? new List<Intervento>();
        interventiSalvati.Add(interventoDaAggiungere);
        await LocalStorage.SetItemAsync(STORAGE_KEY_INTERVENTI, interventiSalvati);

        NavigationManager.NavigateTo("/interventi");
    }

    // Annulla l'operazione di inserimento e torna alla schermata interventi
    private void Annulla() => NavigationManager.NavigateTo("/interventi");
}